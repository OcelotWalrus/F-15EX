  <button n="4">
    <desc type="string">Custom</desc>
    <binding>
      <command type="string">nasal</command>
      <script type="string">
        setprop("fdm/jsbsim/fcs/steer-maneuver",1);
      </script>
    </binding>
    <mod-up>
      <binding type="string">
        <command type="string">nasal</command>
          <script type="string">
            setprop("fdm/jsbsim/fcs/steer-maneuver",0);
          </script>
      </binding>
    </mod-up>
  </button>
  <button n="5">
    <desc type="string">Trigger</desc>
    <repeatable type="string">false</repeatable>
    <binding>
      <command type="string">nasal</command>
      <script type="string">controls.trigger(1);</script>
    </binding>
    <mod-up>
      <binding>
        <command type="string">nasal</command>
        <script type="string">controls.trigger(0);</script>
      </binding>
    </mod-up>
  </button>
  <button n="6">
    <desc type="string">Custom</desc>
    <repeatable type="string">false</repeatable>
    <binding>
      <command type="string">property-toggle</command>
      <property type="string">/ai/submodels/submodel[5]/burst</property>
      <offset type="double">1</offset>
    </binding>
    <mod-up>
      <binding>
        <command type="string">property-toggle</command>
        <property type="string">/ai/submodels/submodel[5]/burst</property>
        <offset type="double">1</offset>
      </binding>
    </mod-up>
  </button>
  <button n="7">
    <desc type="string">Radar Elevation Antennae Up</desc>
    <repeatable type="bool">true</repeatable>
    <binding>
        <command>property-adjust</command>
        <property>instrumentation/radar/ho-field-offset</property>
        <step type="int">-1</step>
        <min>-60</min>
        <max>60</max>
        <wrap>false</wrap>
    </binding>
    <mod-up>
      <binding type="string">
      </binding>
    </mod-up>
  </button>
  <button n="8">
    <desc type="string">Radar Elevation Antennae Down</desc>
    <repeatable type="bool">true</repeatable>
    <binding>
        <command>property-adjust</command>
        <property>instrumentation/radar/ho-field-offset</property>
        <step type="int">1</step>
        <min>-60</min>
        <max>60</max>
        <wrap>false</wrap>
    </binding>
    <mod-up>
      <binding type="string">
      </binding>
    </mod-up>
  </button>
  <button n="9">
    <desc type="string">Toggle bomb dropping modes or guns mode</desc>
    <binding>
      <command type="string">nasal</command>
      <script type="string">
        if (getprop("sim/model/f15/controls/armament/weapon-selector") == 0) {
            guns_mode = getprop("sim/model/f15/armament/gun-sight");
            if (guns_mode == 0) {
                setprop("sim/model/f15/armament/gun-sight", 1);
            } elsif (guns_mode == 1) {
                setprop("sim/model/f15/armament/gun-sight", 2);
            } elsif (guns_mode == 2) {
                setprop("sim/model/f15/armament/gun-sight", 0);
            }
        }
      </script>
    </binding>
    <repeatable type="double">0</repeatable>
  </button>
