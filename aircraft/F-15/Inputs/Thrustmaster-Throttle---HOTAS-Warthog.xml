    <binding>
      <command type="string">property-assign</command>
      <property type="string">controls/armament/emergency-jettison</property>
      <value type="string">1</value>
    </binding>
    <mod-up>
      <binding>
        <command type="string">property-assign</command>
        <property type="string">controls/armament/emergency-jettison</property>
        <value type="string">0</value>
      </binding>
