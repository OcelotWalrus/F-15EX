      <command type="string">nasal</command>
      <script type="string">controls.flapsDown(1);</script>
    </binding>
    <repeatable type="double">0</repeatable>
  </button>
  <button n="23">
    <desc type="string">Master Arm Switch</desc>
    <repeatable type="double">0</repeatable>
    <binding>
      <command type="string">nasal</command>
      <script type="string">aircraft.master_arm_cycle();</script>
    </binding>
    <mod-up>
      <binding>
        <command type="string">nasal</command>
        <script type="string">aircraft.master_arm_cycle();</script>
      </binding>
    </mod-up>
  </button>
  <button n="24">
