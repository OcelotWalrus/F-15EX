        <command type="string">property-assign</command>
        <property type="string">sim/model/f15/controls/AFCS/alt-hold</property>
        <value type="string">0</value>
      </binding>
    </mod-up>
  </button>
  <button n="26">
    <desc type="string">AFCS Heading Switch</desc>
    <repeatable type="double">0</repeatable>
    <binding>
      <command type="string">property-assign</command>
      <property type="string">autopilot/locks/heading</property>
      <value type="string">true-heading-hold</value>
    </binding>
    <mod-up>
      <binding>
        <command type="string">property-assign</command>
        <property type="string">autopilot/locks/heading</property>
        <value type="string">wing-leveler</value>
      </binding>
      <binding>
        <command type="string">property-assign</command>
        <property type="string">sim/model/f15/controls/AFCS/alt-hold</property>
        <value type="string">0</value>
      </binding>
    </mod-up>
    <binding>
      <command type="string">property-assign</command>
      <property type="string">sim/model/f15/controls/AFCS/alt-hold</property>
      <value type="string">1</value>
    </binding>
  </button>
