<?xml version="1.0" encoding="iso-8859-1"?>

<PropertyList>

  <name>warn-loads</name>
  <modal type="bool">false</modal>
  <layout>vbox</layout>
  <width>500</width>

  <group>
    <layout>hbox</layout>
    <empty><stretch>1</stretch></empty>

    <text>
      <label>Loadout Warning</label>
    </text>

    <empty>
      <stretch>1</stretch>
    </empty>

    <button>
      <pref-width>16</pref-width>
      <pref-height>16</pref-height>
      <legend></legend>

      <default>1</default>
      <keynum>27</keynum>
      <border>2</border>
      <legend>X</legend>
      <binding>
        <command>dialog-close</command>
      </binding>
      <binding>
        <command>dialog-apply</command>
      </binding>
    </button>
  </group>

  <hrule/>

  <text>
      <halign>center</halign>
      <property>sim/model/f15/warn-loads-text</property>
      <label>!You need conformal fuel tanks to use that weapon on that hardpoint!</label>
      <live>true</live>
      <format>%s</format>
  </text>

  <hrule/>

 <empty><stretch>1</stretch></empty>

</PropertyList>
