<?xml version="1.0"?>
<PropertyList>
	<name>mission-plan</name>
  	<modal>false</modal>
  	<layout>vbox</layout>
  	<draggable>true</draggable>
    <resizable>false</resizable>
    <width>3048</width>
    <!--<height>250</height>-->

    <nasal>
        <open><![CDATA[
            var defaultDirInFileSelector = getprop("/sim/fg-home") ~ "/Export";

            setprop("sim/model/f15/preplanning-status", "");
            var file_selector_dtc = gui.FileSelector.new(
              callback: cartridge.load_cartridge, title: "Load data", button: "Load",
              dir: defaultDirInFileSelector, dotfiles: 1, pattern: ["*.f15dtc"]);
            var save_selector_dtc = gui.FileSelector.new(
              callback: cartridge.save_cartridge, title: "Save data", button: "Save",
              dir: defaultDirInFileSelector, dotfiles: 1, file: "f15-dtc-data.f15dtc", pattern: ["*.f15dtc"]);

        ]]></open>

        <close><![CDATA[
            file_selector_dtc.del();
            save_selector_dtc.del();
        ]]></close>
    </nasal>

    <group>
		<layout>hbox</layout>
		<text>
			<halign>right</halign>
			<label>F-15EX Eagle II Mission Data</label>
		</text>

		<group>
			<layout>table</layout>
			<button>
				<row>0</row>
				<col>1</col>
				<halign>right</halign>
				<pref-width>20</pref-width>
				<pref-height>20</pref-height>
				<legend>X</legend>
				<key>Esc</key>
				<binding>
					<command>dialog-close</command>
				</binding>
			</button>
		</group>
	</group>

	<hrule/>

	<text><halign>center</halign><label>Data Transfer Cartridge settings</label></text>
	<empty><stretch>1</stretch></empty>

	<group>
		<layout>hbox</layout>
		<button>
	        <legend>Load DTC</legend>
	        <equal>true</equal>
	        <binding>
	            <command>nasal</command>
	            <script>file_selector_dtc.open()</script>
	        </binding>
	    </button>
	    <button>
	        <legend>Save DTC</legend>
	        <equal>true</equal>
	        <enable>
	        	<value>1</value>
	        </enable>
	        <binding>
	            <command>nasal</command>
	            <script>save_selector_dtc.open();</script>
	        </binding>
	    </button>
	</group>

	<empty><stretch>1</stretch></empty>
