<?xml version="1.0" encoding="iso-8859-1"?>
  
<PropertyList> 

    <path>Aircraft/F-15/Models/Stores/Racks/BRU-57/BRU-57.xml</path>

    <model>
      <name>Station1_AGM154_left</name>
      <path>Aircraft/F-15/Models/Stores/AGM-154A/AGM-154A.xml</path>
      <offsets>
        <x-m>0.145</x-m>
        <y-m>-0.3</y-m>
        <z-m>-0.453</z-m>
        <pitch-deg>0</pitch-deg>
        <roll-deg>00</roll-deg>
      </offsets>
    </model>

    <model>
      <name>Station1_AGM154_right</name>
      <path>Aircraft/F-15/Models/Stores/AGM-154A/AGM-154A.xml</path>
      <offsets>
        <x-m>0.145</x-m>
        <y-m>0.3</y-m>
        <z-m>-0.453</z-m>
        <pitch-deg>0</pitch-deg>
        <roll-deg>00</roll-deg>
      </offsets>
    </model>

    <animation>
      <type>select</type>
      <object-name>Station1_AGM154_left</object-name>
      <condition><and>
        <equals>
          <property>payload/armament/station/id-1-type</property>
          <value>AGM-154A</value>
        </equals>
        <greater-than>
          <property>payload/armament/station/id-1-count</property>
          <value>0</value>
        </greater-than></and>
      </condition>
     </animation>

     <animation>
      <type>select</type>
      <object-name>Station1_AGM154_right</object-name>
      <condition>
        <and>
        <equals>
          <property>payload/armament/station/id-1-type</property>
          <value>AGM-154A</value>
        </equals>
        <greater-than>
          <property>payload/armament/station/id-1-count</property>
          <value>1</value>
        </greater-than>
      </and>
      </condition>
     </animation>

</PropertyList> 
