<?xml version="1.0"?>

<PropertyList>

  <model>
    <name>gamma1</name>
    <path>Aircraft/F-15/Models/pilot.xml</path>
    <offsets>
      <x-m> 0</x-m>
      <y-m> 0</y-m>
      <z-m> 0</z-m>
    </offsets>
  </model>

  <model> <!-- same chair model as the F-15 actually-->
    <name>gamma2</name>
    <path>Aircraft/F-15/Models/Cockpit/chair/chair.xml</path>
    <offsets>
      <x-m> -0.95</x-m>
      <y-m> 0</y-m>
      <z-m> 0.485</z-m>
    </offsets>
  </model>

  <model>
    <name>gamma3</name>
    <path>Aircraft/F-15/Models/Stores/parachutist.xml</path>
    <offsets>
      <x-m> -5</x-m>
      <y-m> 0</y-m>
      <z-m> -3</z-m>
    </offsets>
  </model>

  <!--<model>
    <name>gamma3</name>
