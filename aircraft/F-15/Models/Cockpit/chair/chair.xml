<?xml version="1.0"?>

<PropertyList>

 <path>chair.ac</path>


<!-- PICK ANIMATIONS -->

 <animation>
    <type>pick</type>
    <visible>true</visible>
    <object-name>ejection-safety-lever</object-name>
    <action>
     <button>0</button>
     <binding>
        <command>property-toggle</command>
        <property>controls/seat/ejection-safety-lever</property>
     </binding>
    </action>
   </animation>

 <animation>
    <type>pick</type>
    <visible>true</visible>
    <object-name>eject-handle</object-name>
    <action>
     <button>0</button>
     <repeatable>false</repeatable>
     <binding>
      <command>nasal</command>
      <script>
                aircraft.eject_f15();
      </script>
     </binding>
    </action>
   </animation>


<!-- SWITCH ANIMATIONS -->

 <animation>
  <type>rotate</type>
  <object-name>ejection-safety-lever</object-name>
  <property>controls/seat/ejection-safety-lever</property>
  <factor>120</factor>
  <offset-deg>-120</offset-deg>
  <center>
   <x-m>-4.523</x-m>
   <y-m>-0.24</y-m>
   <z-m>0.215</z-m>
  </center>
  <axis>
   <x>0</x>
   <y>1</y>
   <z>0</z>
  </axis>
 </animation>


    <animation>
      <type>material</type>
      <object-name>seat-cushion</object-name>
      <condition>
            <greater-than>
              <property>sim/variant-id</property>
              <value>3</value>
            </greater-than>
      </condition>
      <texture>seat-cushion-b2.png</texture>
    </animation>

    <animation>
      <type>material</type>
      <object-name>back-cushion</object-name>
      <condition>
            <greater-than>
              <property>sim/variant-id</property>
              <value>3</value>
            </greater-than>
      </condition>
      <texture>seat-cushion-b.png</texture>
    </animation>


</PropertyList>
